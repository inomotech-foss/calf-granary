{ config, lib, ... }:
let
  cfg = config.granary.ephemeris.cornucopia;
in
{
  options.granary.ephemeris.cornucopia = {
    enable = lib.mkEnableOption "Postgres bindings generated by cornucopia";
    migrations = lib.mkOption {
      type = lib.types.str;
      description = "Directory with the `NNNN_name.sql` migrations, relative to the repository root.";
    };
    queries = lib.mkOption {
      type = lib.types.str;
      description = "Directory with the query files, relative to the repository root.";
    };
    destination = lib.mkOption {
      type = lib.types.str;
      description = "Directory of the generated package, relative to the repository root.";
    };
    name = lib.mkOption {
      type = lib.types.str;
      description = "Name of the generated package.";
    };
    description = lib.mkOption {
      type = lib.types.str;
      description = "Description of the generated package.";
    };
    keywords = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = "Keywords of the generated package.";
    };
  };

  config = lib.mkIf cfg.enable {
    ephemeris.generated.db = {
      services = [ "postgres" ];
      outputs = [ cfg.destination ];
      inputs = [
        cfg.migrations
        cfg.queries
      ];
    };

    perSystem =
      {
        config,
        inputs',
        pkgs,
        ...
      }:
      let
        generate = pkgs.writeShellApplication {
          name = "cornucopia-generate";
          runtimeInputs = [
            inputs'.cornucopia.packages.cornucopia
            pkgs.coreutils
            config.ephemeris.rust.rustfmt
            config.ephemeris.services.postgres.package
          ];
          text = ''
            root=$PWD
            destination=$(realpath -m "$1/${cfg.destination}")
            mkdir -p "$(dirname "$destination")"
            work=$(mktemp -d)
            trap 'rm -rf "$work"' EXIT

            for migration in "$root/${cfg.migrations}"/*.sql; do
              psql --quiet --set ON_ERROR_STOP=1 --file "$migration"
            done

            cat >"$work/cornucopia.toml" <<EOF
            queries = "$root/${cfg.queries}"
            destination = "$destination"
            async = true
            sync = false
            use-workspace-deps = "$root/Cargo.toml"
            wasm-features = false

            [style]
            enum-variant-camel-case = true

            [manifest.package]
            name = "${cfg.name}"
            description = "${cfg.description}"
            categories = ["database"]
            keywords = [${lib.concatMapStringsSep ", " builtins.toJSON cfg.keywords}]
            publish = false
            license = { workspace = true }
            readme = { workspace = true }
            repository = { workspace = true }
            version = { workspace = true }
            EOF
            cornucopia live --config "$work/cornucopia.toml" \
              "postgresql:///$PGDATABASE?host=$PGHOST&port=$PGPORT&user=$PGUSER" >/dev/null

            find "$destination" -name '*.rs' -exec \
              rustfmt --edition 2024 --config-path "$root/rustfmt.toml" {} +
          '';
        };
      in
      {
        ephemeris.generated.db.program = generate;
      };
  };
}
