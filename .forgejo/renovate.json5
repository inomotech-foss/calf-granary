{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  configMigration: true,
  dependencyDashboard: true,
  dependencyDashboardApproval: true,
  enabledManagers: ["github-actions", "nix", "cargo"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
  },
  packageRules: [
    {
      description: "Pin Docker image digests",
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      description: "Pin action digests",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      description: "Recognize Grafana security releases",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "grafana/grafana",
        "docker.io/grafana/grafana",
        "grafana/grafana-enterprise",
        "docker.io/grafana/grafana-enterprise",
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-security-(?<build>\\d+))?(?:-(?<compatibility>.*))?$",
    },
    {
      description: "Pin development dependencies",
      matchDepTypes: ["devDependencies"],
      rangeStrategy: "pin",
    },
    {
      description: "Wait before npm updates",
      matchDatasources: ["npm"],
      minimumReleaseAge: "3 days",
    },
    {
      abandonmentThreshold: "1 year",
      description: "Detect dependencies abandoned for a year",
      matchPackageNames: ["*"],
    },
    {
      description: "Inomotech actions use immutable tags",
      matchManagers: ["github-actions"],
      matchPackageNames: ["inomotech/**", "https://codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      description: "Inomotech container images use immutable tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      description: "Leave in-range Cargo updates to lockfile maintenance",
      matchManagers: ["cargo"],
      rangeStrategy: "replace",
    },
    {
      automerge: true,
      description: "Automerge lockfile-only updates",
      groupName: "Lockfile updates",
      groupSlug: "lockfile",
      matchJsonata: ["isLockfileUpdate = true"],
    },
    {
      description: "Resolve Inomotech actions through Codeberg",
      matchDatasources: ["github-tags"],
      matchManagers: ["github-actions"],
      matchPackageNames: ["inomotech/**"],
      overrideDatasource: "forgejo-tags",
      registryUrls: ["https://codeberg.org"],
      versioning: "docker",
    },
    {
      description: "Reconcile Ephemeris after its flake input updates",
      groupName: null,
      matchDepNames: ["ephemeris"],
      matchManagers: ["nix"],
      postUpgradeTasks: {
        commands: ["nix run .#ephemeris -- files apply"],
        executionMode: "update",
        fileFilters: ["**/*"],
      },
    },
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
}
