{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboard: true,
  dependencyDashboardApproval: true,
  enabledManagers: ["github-actions", "nix", "cargo", "npm"],
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".envrc",
    ".forgejo/renovate.json5",
    ".forgejo/workflows/dependency-updates.yaml",
    ".forgejo/workflows/deploy.yaml",
    ".forgejo/workflows/pull-request.yaml",
    ".forgejo/workflows/repository.yaml",
    ".gitignore",
    "LICENSE",
    "README.md",
    "clippy.toml",
    "rust-toolchain.toml",
    "rustfmt.toml",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
  },
  packageRules: [
    {
      description: "Pin Docker image digests",
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      description: "Inomotech container images use immutable tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      abandonmentThreshold: "1 year",
      description: "Detect dependencies abandoned for a year",
      matchPackageNames: ["*"],
    },
    {
      description: "Pin action digests",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      description: "Inomotech actions use immutable tags",
      matchManagers: ["github-actions"],
      matchPackageNames: ["inomotech/**", "https://codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      description: "Leave in-range Cargo updates to lockfile maintenance",
      matchManagers: ["cargo"],
      rangeStrategy: "replace",
    },
    {
      description: "Reconcile Ephemeris after its flake input updates",
      groupName: null,
      matchDepNames: ["ephemeris"],
      matchManagers: ["nix"],
      postUpgradeTasks: {
        commands: [
          "nix run .#ephemeris -- files apply",
          "nix run .#ephemeris-generate",
        ],
        executionMode: "update",
        fileFilters: ["**/*"],
      },
    },
    {
      description: "Reconcile Ephemeris after other flake input updates",
      matchDepNames: ["!ephemeris"],
      matchManagers: ["nix"],
      postUpgradeTasks: {
        commands: [
          "nix run .#ephemeris -- files apply",
          "nix run .#ephemeris-generate",
        ],
        executionMode: "update",
        fileFilters: ["**/*"],
      },
    },
    {
      description: "Regenerate the lockfile after npm updates",
      matchManagers: ["npm"],
      postUpgradeTasks: {
        commands: ["nix run .#ephemeris-generate"],
        executionMode: "update",
        fileFilters: ["**/package.json", "**/package-lock.json"],
      },
    },
    {
      description: "Leave the tools that Ephemeris pins to Ephemeris",
      enabled: false,
      matchPackageNames: ["prettier"],
    },
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
}
