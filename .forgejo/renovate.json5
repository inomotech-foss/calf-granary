{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboard: true,
  dependencyDashboardApproval: true,
  enabledManagers: ["github-actions", "nix", "cargo", "npm"],
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".envrc",
    ".forgejo/renovate.json5",
    ".forgejo/workflows/dependency-updates.yaml",
    ".forgejo/workflows/pull-request.yaml",
    ".gitignore",
    "LICENSE",
    "README.md",
    "clippy.toml",
    "rust-toolchain.toml",
    "rustfmt.toml",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
  },
  packageRules: [
    {
      description: "Pin Docker image digests",
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      description: "Inomotech container images use immutable tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      abandonmentThreshold: "1 year",
      description: "Detect dependencies abandoned for a year",
      matchPackageNames: ["*"],
    },
    {
      description: "Pin action digests",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      description: "Inomotech actions use immutable tags",
      matchManagers: ["github-actions"],
      matchPackageNames: ["inomotech/**", "https://codeberg.org/inomotech/**"],
      pinDigests: false,
    },
    {
      description: "Leave in-range Cargo updates to lockfile maintenance",
      matchManagers: ["cargo"],
      rangeStrategy: "replace",
    },
    {
      description: "Reconcile Ephemeris after its flake input updates",
      groupName: null,
      matchDepNames: ["ephemeris"],
      matchManagers: ["nix"],
      postUpgradeTasks: {
        commands: ["nix run .#ephemeris -- files apply"],
        executionMode: "update",
        fileFilters: ["**/*"],
      },
    },
    {
      description: "Refresh the vendored pnpm dependency hash after npm updates",
      matchManagers: ["npm"],
      postUpgradeTasks: {
        commands: ["nix run .#ephemeris-typescript-hash"],
        executionMode: "update",
        fileFilters: ["**/*.nix"],
      },
    },
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
}
